# Nest backend origin WITHOUT /api/v1 (added by server adapter).
# Never exposed to the browser. Frontend listens on 3001.
BACKEND_URL=http://127.0.0.1:3000
# Required in production: openssl rand -hex 32
SESSION_SECRET=
# Set exact external HTTPS origin behind a production reverse proxy.
